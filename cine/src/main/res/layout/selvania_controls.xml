<?xml version="1.0" encoding="utf-8"?>
<!-- Commandes du lecteur aux couleurs Selvania (ids attendus par Media3) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/shade_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingTop="72dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1"
                app:bar_height="5dp"
                app:buffered_color="#59FFFFFF"
                app:played_color="#FFF7A01F"
                app:scrubber_color="#FFFFFFFF"
                app:scrubber_dragged_size="22dp"
                app:scrubber_enabled_size="16dp"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/ctrl_btn"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@id/exo_rew"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ctrl_btn"
                android:contentDescription="@null"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rew10" />

            <ImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ctrl_btn"
                android:contentDescription="@null"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ffwd10" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@id/exo_subtitle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/ctrl_btn"
                android:contentDescription="@null"
                android:padding="13dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@id/exo_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ctrl_btn"
                android:contentDescription="@null"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/exo_styled_controls_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>