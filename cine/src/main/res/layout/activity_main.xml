<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graphite"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/graphite" />

        <FrameLayout
            android:id="@+id/splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/graphite">

            <ImageView
                android:layout_width="320dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/banner" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/offline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/graphite"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:src="@drawable/logo_tile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/offline_title"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/offline_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/offline_text"
                android:textColor="@color/text_2"
                android:textSize="15sp" />

            <Button
                android:id="@+id/retry"
                android:layout_width="240dp"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/btn_gold"
                android:focusable="true"
                android:stateListAnimator="@null"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="#FF1B1104"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Mini télécommande Chromecast (affichée seulement pendant une diffusion) -->
    <ViewStub
        android:id="@+id/cast_mini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout="@layout/cast_mini" />
</LinearLayout>
